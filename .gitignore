# Downloaded HDR environment maps stay local (only the generated studio HDRs are tracked)
scenes/assets/*_4k.hdr

# Grading-report PDFs stay local (ingest them with report_to_toml.py)
*.pdf

# Per-stone gem scenes generated by report_to_toml.py stay local too
# (only scene.toml, sample.toml and bench.toml are tracked)
scenes/gem_*.toml
scenes/[0-9]*.toml
scenes/LG*.toml

# Purchased Poly Haven assets stay local (only the generated studio HDRs are tracked)
scenes/assets/greyChart_*
scenes/assets/hdri_lightbox_*
scenes/assets/camera_*
